[Unit]
Description=Paper Minecraft Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=minecraft
Group=minecraft
WorkingDirectory=/opt/minecraft/server

ExecStart=/usr/bin/java -Xms1G -Xmx2500M -jar paper.jar --nogui

Restart=on-failure
RestartSec=10

TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
